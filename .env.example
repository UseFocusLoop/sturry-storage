# Copy this file to ".env" and fill in the values.
# Never commit the real .env — it's gitignored.

# --- Contact form (Web3Forms) ---------------------------------------------
# Free key from https://web3forms.com — routes enquiries to your email.
PUBLIC_WEB3FORMS_KEY=

# --- TinaCMS (Tina Cloud) --------------------------------------------------
# From your Tina Cloud project at https://app.tina.io
# Overview tab -> Client ID; Tokens tab -> a read-only token.
TINA_PUBLIC_CLIENT_ID=
TINA_TOKEN=

# The Git branch Tina reads/writes. Usually "main". The host normally sets this
# automatically, so you can leave it blank.
TINA_BRANCH=
