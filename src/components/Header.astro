---
import { business, links } from "../data/business";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${business.legalName} home`}>
      <Logo variant="light" />
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <a href="/container-storage/">Container storage</a>
      <a href="/yard-space/">Yard &amp; open storage</a>
    </nav>

    <div class="header-actions">
      <a href={links.tel} class="btn btn-wa header-cta">
        <Icon name="phone" size={15} />
        Call
      </a>
      <a
        href={links.whatsapp}
        class="btn btn-whatsapp header-cta"
        target="_blank"
        rel="noopener"
      >
        <Icon name="whatsapp" size={15} />
        WhatsApp
      </a>
    </div>

    <!-- Mobile menu: a native <details> disclosure, no JavaScript. -->
    <details class="mobile-menu">
      <summary aria-label="Menu">
        <span class="bars" aria-hidden="true"></span>
        Menu
      </summary>
      <div class="mobile-menu-panel">
        <a href="/container-storage/">Container storage</a>
        <a href="/yard-space/">Yard &amp; open storage</a>
        <a href={links.tel} class="btn btn-call">
          <Icon name="phone" size={16} /> Call {business.phoneDisplay}
        </a>
        <a href={links.sms} class="btn btn-sms">
          <Icon name="message" size={16} /> Text us
        </a>
        <a href={links.whatsapp} class="btn btn-whatsapp" target="_blank" rel="noopener">
          <Icon name="whatsapp" size={16} /> WhatsApp
        </a>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    background: var(--navy-deep);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    position: sticky;
    top: 0;
    z-index: 30;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 104px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    white-space: nowrap;
  }
  /* Scale the logo + wordmark up a touch for the bigger bar. */
  .brand :global(.logo-mark) {
    height: 60px;
  }
  .brand :global(.logo-word-1) {
    font-size: 2rem;
  }
  .brand :global(.logo-word-2) {
    font-size: 0.66rem;
  }
  .primary-nav {
    display: none;
    gap: 1.4rem;
  }
  .primary-nav a {
    color: #fff;
    text-decoration: none;
    font-weight: 500;
    font-size: 1.125rem;
  }
  .primary-nav a:hover {
    color: var(--green-bright);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .header-actions {
    display: none;
    gap: 0.6rem;
  }
  /* Smaller, lighter-weight header buttons. */
  .header-cta {
    min-height: 40px;
    padding: 0.42rem 0.95rem;
    font-size: 0.9375rem;
    font-weight: 500;
    gap: 0.4rem;
  }

  /* ---- Mobile menu (details/summary) ---- */
  .mobile-menu {
    position: relative;
  }
  .mobile-menu summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.4rem 0.6rem;
    font-family: var(--font-head);
    font-weight: 600;
    color: #fff;
    list-style: none;
    cursor: pointer;
    user-select: none;
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .bars {
    width: 20px;
    height: 2px;
    background: #fff;
    box-shadow: 0 6px 0 #fff, 0 -6px 0 #fff;
    display: inline-block;
  }
  .mobile-menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 220px;
    padding: 0.75rem;
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgba(13, 27, 46, 0.12);
  }
  .mobile-menu-panel a:not(.btn) {
    color: var(--navy);
    text-decoration: none;
    font-weight: 500;
    padding: 0.6rem 0.5rem;
    border-radius: 4px;
  }
  .mobile-menu-panel a:not(.btn):hover {
    background: var(--paper);
  }
  .mobile-menu-panel .btn {
    margin-top: 0.4rem;
  }

  @media (min-width: 768px) {
    .primary-nav {
      display: flex;
      flex: 1;
      justify-content: center;
    }
    .header-actions {
      display: inline-flex;
    }
    .mobile-menu {
      display: none;
    }
  }
</style>
