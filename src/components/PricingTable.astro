---
import { getCollection } from "astro:content";
import { business } from "../data/business";

// Optional: only show rows of this category ("container" / "yard").
// No category = show every available row (used on the homepage).
interface Props {
  category?: string;
}
const { category } = Astro.props;

// Rows come from the pricing collection (src/content/pricing/*.md), so the
// client edits prices in the CMS. Hidden (available: false) rows are dropped.
const priceText = (d: {
  priceFrom?: number | null;
  priceUnit: string;
  priceNote: string;
}) => (d.priceFrom != null ? `from £${d.priceFrom}/${d.priceUnit}` : d.priceNote);

const rows = (await getCollection("pricing"))
  .filter((e) => e.data.available && (!category || e.data.category === category))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({ size: e.data.name, fits: e.data.whatFits, price: priceText(e.data) }));

const anyPlaceholder = business.pricesIndicative;
---

<div class="table-wrap">
  <table class="pricing">
    <caption class="visually-hidden">Storage sizes and prices</caption>
    <thead>
      <tr>
        <th scope="col">Size</th>
        <th scope="col">Roughly what fits</th>
        <th scope="col">Price from</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <th scope="row" class="tnum">{r.size}</th>
            <td data-label="Roughly what fits">{r.fits}</td>
            <td class="tnum price" data-label="Price from">{r.price}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

{
  anyPlaceholder && (
    <p class="placeholder-note">
      {/* Visible reminder — remove once real prices are set in business.ts */}
      Prices shown are indicative starting points. Call for a firm quote on your
      needs.
    </p>
  )
}

<style>
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow-md);
  }
  table.pricing {
    width: 100%;
    border-collapse: collapse;
    min-width: 36rem;
  }
  .pricing th,
  .pricing td {
    text-align: left;
    padding: 1.1rem 1.25rem;
    vertical-align: top;
    border-bottom: 1px solid var(--hairline);
  }
  .pricing thead th {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: var(--step-small);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--white) 82%, var(--navy));
    background: var(--navy);
    border-bottom: none;
  }
  .pricing tbody tr {
    transition: background-color 0.12s ease;
  }
  .pricing tbody tr:hover {
    background: var(--blue-tint);
  }
  .pricing tbody th {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--navy);
    white-space: nowrap;
  }
  .pricing tbody tr:last-child th,
  .pricing tbody tr:last-child td {
    border-bottom: none;
  }
  .pricing td {
    color: var(--steel);
    line-height: 1.5;
  }
  .price {
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--green-dark);
    white-space: nowrap;
  }

  /* On narrow screens, stack each row as a full-width card. */
  @media (max-width: 640px) {
    .table-wrap {
      overflow-x: visible;
      border: none;
      background: transparent;
      box-shadow: none;
    }
    table.pricing,
    .pricing tbody {
      display: block;
      min-width: 0;
      width: 100%;
    }
    .pricing thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .pricing tbody tr {
      display: block;
      padding: 1.25rem;
      margin-bottom: 0.9rem;
      background: var(--white);
      border: 1px solid var(--hairline);
      border-left: 4px solid var(--blue);
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
    }
    .pricing tbody tr:hover {
      background: var(--white);
    }
    .pricing tbody th,
    .pricing tbody td {
      display: block;
      padding: 0;
      border: none;
      white-space: normal;
    }
    .pricing tbody th {
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
    }
    .pricing tbody td {
      padding-top: 0.6rem;
    }
    .pricing tbody td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-family: var(--font-head);
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--blue);
      margin-bottom: 0.2rem;
    }
    .price {
      font-size: 1.125rem;
    }
  }
  .placeholder-note {
    font-size: var(--step-small);
    color: var(--steel);
    margin-top: 0.75rem;
  }
</style>
