---
import { business, links, addressOneLine } from "../data/business";
import Logo from "./Logo.astro";
const year = new Date().getFullYear();
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
  addressOneLine
)}`;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <Logo variant="light" class="footer-logo" />
      <p class="footer-line footer-tagline">
        Container and yard storage serving Canterbury, Sturry, Whitstable,
        Herne Bay and surrounding East Kent.
      </p>
      <p class="footer-line footer-addr">{addressOneLine}</p>
      <p class="footer-line">
        <a href={directionsUrl} target="_blank" rel="noopener">Get directions</a>
      </p>
    </div>

    <div>
      <p class="footer-heading">Get in touch</p>
      <p class="footer-line">
        <a href={links.tel}>Call {business.phoneDisplay}</a>
      </p>
      <p class="footer-line">
        <a href={links.whatsapp} target="_blank" rel="noopener">WhatsApp us</a>
      </p>
      <p class="footer-line">
        <a href={links.email}>{business.email}</a>
      </p>
      {
        business.accessHoursConfirmed && (
          <p class="footer-line">{business.accessHours}</p>
        )
      }
    </div>

    <div>
      <p class="footer-heading">Company</p>
      <p class="footer-line">{business.legalName}</p>
      <p class="footer-line">Registered in England &amp; Wales</p>
      {
        business.companyNumber && (
          <p class="footer-line">Company no. {business.companyNumber}</p>
        )
      }
    </div>
  </div>

  <div class="container footer-base">
    <p>&copy; {year} {business.legalName}. All rights reserved.</p>
    <nav class="footer-legal" aria-label="Legal">
      <a href="/privacy/">Privacy policy</a>
      <a href="/terms/">Terms &amp; conditions</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-deep);
    color: color-mix(in srgb, var(--white) 82%, var(--navy-deep));
    padding-block: 2.5rem 6rem; /* extra bottom padding clears the mobile call bar */
    margin-top: 2rem;
  }
  .footer-grid {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: 1fr;
  }
  .footer-logo {
    margin-bottom: 0.85rem;
  }
  .footer-line.footer-tagline {
    margin: 0 0 0.75rem;
  }
  .footer-addr {
    margin-top: 0;
  }
  .footer-heading {
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--white);
    font-size: var(--step-small);
    margin: 0 0 0.4rem;
  }
  .footer-line {
    margin: 0.15rem 0;
    font-size: var(--step-small);
    line-height: 1.5;
    max-width: none;
  }
  .footer-line a {
    color: color-mix(in srgb, var(--green) 55%, var(--white));
  }
  .footer-base {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--white) 14%, transparent);
    font-size: var(--step-small);
    color: color-mix(in srgb, var(--white) 60%, var(--navy-deep));
  }
  .footer-base p {
    margin: 0;
  }
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 0.6rem;
  }
  .footer-legal a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .footer-legal a:hover {
    color: var(--white);
  }
  @media (min-width: 700px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }
  /* The fixed contact bar shows below 768px, so only drop the extra bottom
     clearance once it's gone — otherwise it overlaps the footer at 700–767px. */
  @media (min-width: 768px) {
    .site-footer {
      padding-bottom: 2.5rem;
    }
  }
</style>
