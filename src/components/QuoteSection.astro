---
/*
  The closing "Get a quote" section used at the bottom of every page:
  a heading + Call/WhatsApp buttons + the 3-step quote questionnaire.
  One shared component so it's identical and seamless site-wide.
*/
import QuoteForm from "./QuoteForm.astro";
import Icon from "./Icon.astro";
import { business, links, web3formsKey } from "../data/business";

// The questionnaire only appears once a Web3Forms key is set. Until then we
// don't promise a form the visitor can't use — we point them at Call/Text/WhatsApp.
const formConfigured = web3formsKey.length > 0;
---

<section class="section container quote-section" id="quote">
  <div class="section-head">
    <h2>Get a quote</h2>
    <p class="lead">
      {
        formConfigured
          ? "Quickest way is to call, text or WhatsApp — you'll get a straight answer on price and availability. Or answer a few quick questions and we'll come back to you."
          : "Give us a call, text or WhatsApp and you'll get a straight answer on price and availability."
      }
    </p>
  </div>

  <div class="quote-actions">
    <a href={links.tel} class="btn btn-primary btn-lg">
      <Icon name="phone" size={20} />
      Call {business.phoneDisplay}
    </a>
    <a href={links.sms} class="btn btn-ghost btn-lg">
      <Icon name="message" size={19} />
      Text us
    </a>
    <a
      href={links.whatsapp}
      class="btn btn-wa btn-lg"
      target="_blank"
      rel="noopener"
    >
      <Icon name="whatsapp" size={20} />
      Message us on WhatsApp
    </a>
  </div>

  <QuoteForm />
</section>

<style>
  .quote-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1.5rem 0 2rem;
  }
</style>
