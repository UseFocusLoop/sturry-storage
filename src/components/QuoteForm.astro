---
/*
  3-step "Get a quote" questionnaire.
  Progressive enhancement: with no JavaScript every step is visible and it works
  as one long form. With JS it becomes a stepped wizard (Next/Back + progress).
  Submits to Web3Forms (same free service as before) and emails the full set of
  answers to the business, then lands the visitor on /thank-you.
*/
import { business } from "../data/business";

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
const configured = accessKey.length > 0;
---

{
  !configured && (
    <p class="qf-notice">
      <strong>Quote form not connected yet.</strong> Add your free Web3Forms key
      as <code>PUBLIC_WEB3FORMS_KEY</code> and enquiries will start emailing
      through. Until then, use the Call or WhatsApp buttons.
    </p>
  )
}

<form
  class="quote-form"
  action="https://api.web3forms.com/submit"
  method="POST"
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="New storage quote request from the website" />
  <input type="hidden" name="from_name" value={business.legalName} />
  <input type="hidden" name="redirect" value="/thank-you/" />
  <input
    type="checkbox"
    name="botcheck"
    class="visually-hidden"
    style="display:none"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <p class="qf-progress" aria-live="polite"><span class="qf-step-num">Step 1</span> of 3</p>
  <div class="qf-bar" aria-hidden="true"><span class="qf-bar-fill"></span></div>

  <!-- STEP 1 -->
  <fieldset class="qf-step" data-step="1">
    <legend>What are you looking to store with?</legend>
    <div class="qf-options">
      {[
        "20ft container",
        "40ft container",
        "Gated storage yard",
        "Open storage space",
        "Not sure yet",
      ].map((opt, i) => (
        <label class="qf-option">
          <input type="radio" name="storage_type" value={opt} required={i === 0 ? true : undefined} />
          <span>{opt}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <!-- STEP 2 -->
  <fieldset class="qf-step" data-step="2" hidden>
    <legend>A few quick details</legend>

    <p class="qf-q">How long do you need it for?</p>
    <div class="qf-options qf-options--wrap">
      {["Under a month", "1–3 months", "3–6 months", "6+ months", "Not sure"].map((opt, i) => (
        <label class="qf-option qf-option--pill">
          <input type="radio" name="how_long" value={opt} required={i === 0 ? true : undefined} />
          <span>{opt}</span>
        </label>
      ))}
    </div>

    <p class="qf-q">When do you need it?</p>
    <div class="qf-options qf-options--wrap">
      {["As soon as possible", "In the next few weeks", "Just getting prices"].map((opt, i) => (
        <label class="qf-option qf-option--pill">
          <input type="radio" name="when" value={opt} required={i === 0 ? true : undefined} />
          <span>{opt}</span>
        </label>
      ))}
    </div>

    <div class="qf-field">
      <label for="qf-storing">What are you storing? <span class="qf-opt">(optional)</span></label>
      <textarea id="qf-storing" name="what_storing" rows="2" placeholder="e.g. builder's tools and materials, or stock overflow"></textarea>
    </div>
  </fieldset>

  <!-- STEP 3 -->
  <fieldset class="qf-step" data-step="3" hidden>
    <legend>Where do we send your quote?</legend>

    <div class="qf-field">
      <label for="qf-name">Your name</label>
      <input id="qf-name" name="name" type="text" required autocomplete="name" />
    </div>
    <div class="qf-field">
      <label for="qf-phone">Phone number</label>
      <input id="qf-phone" name="phone" type="tel" required inputmode="tel" autocomplete="tel" placeholder="So we can call or text you back" />
    </div>
    <div class="qf-field">
      <label for="qf-email">Email <span class="qf-opt">(optional)</span></label>
      <input id="qf-email" name="email" type="email" autocomplete="email" />
    </div>

    <p class="qf-q">Best way to reach you?</p>
    <div class="qf-options qf-options--wrap">
      {["Call", "Text", "WhatsApp", "Email"].map((opt) => (
        <label class="qf-option qf-option--pill">
          <input type="radio" name="preferred_contact" value={opt} />
          <span>{opt}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <!-- Controls -->
  <div class="qf-controls">
    <button type="button" class="btn btn-ghost qf-back" hidden>Back</button>
    <button type="button" class="btn btn-primary qf-next">Next</button>
    <button type="submit" class="btn btn-primary qf-submit" hidden disabled={!configured}>
      Get my quote
    </button>
  </div>
  <p class="qf-foot">We'll call or text you back with a price. We don't share your details.</p>
</form>

<style>
  .quote-form {
    max-width: 40rem;
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    box-shadow: var(--shadow-md);
  }
  .qf-progress {
    margin: 0 0 0.5rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: var(--step-small);
    color: var(--steel);
  }
  .qf-step-num {
    color: var(--green-dark);
  }
  .qf-bar {
    height: 6px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--navy) 10%, var(--white));
    overflow: hidden;
    margin-bottom: 1.5rem;
  }
  .qf-bar-fill {
    display: block;
    height: 100%;
    width: 33.33%;
    background: var(--green);
    border-radius: 999px;
    transition: width 0.25s ease;
  }
  .qf-step {
    border: none;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .qf-step legend {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--step-h3);
    color: var(--navy);
    letter-spacing: -0.01em;
    margin-bottom: 1rem;
    padding: 0;
  }
  .qf-q {
    font-weight: 500;
    color: var(--navy);
    margin: 1.25rem 0 0.6rem;
  }
  .qf-options {
    display: grid;
    gap: 0.6rem;
  }
  .qf-options--wrap {
    grid-auto-flow: row;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
  }
  .qf-option {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1rem;
    border: 1.5px solid var(--hairline);
    border-radius: var(--radius);
    cursor: pointer;
    font-weight: 500;
    color: var(--navy);
    transition: border-color 0.12s ease, background-color 0.12s ease;
  }
  .qf-option--pill {
    padding: 0.6rem 0.9rem;
    justify-content: center;
    text-align: center;
    gap: 0.4rem;
  }
  .qf-option:hover {
    border-color: color-mix(in srgb, var(--green) 55%, var(--hairline));
  }
  .qf-option input {
    accent-color: var(--green);
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
  }
  .qf-option--pill input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  /* Selected state */
  .qf-option:has(input:checked) {
    border-color: var(--green);
    background: var(--blue-tint);
  }
  .qf-option:has(input:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .qf-field {
    display: grid;
    gap: 0.35rem;
    margin-top: 1rem;
  }
  .qf-field label {
    font-weight: 500;
    color: var(--navy);
    font-size: var(--step-body);
  }
  .qf-opt {
    color: var(--steel);
    font-weight: 400;
  }
  .qf-field input,
  .qf-field textarea {
    font-family: var(--font-body);
    font-size: var(--step-body);
    color: var(--navy);
    background: var(--white);
    border: 1px solid var(--steel);
    border-radius: var(--radius);
    padding: 0.7rem 0.8rem;
    min-height: 48px;
    width: 100%;
  }
  .qf-field textarea {
    min-height: auto;
    resize: vertical;
  }
  .qf-controls {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .qf-next,
  .qf-submit {
    margin-left: auto;
  }
  .qf-foot {
    font-size: var(--step-small);
    color: var(--steel);
    margin: 0.9rem 0 0;
  }
  .btn[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .qf-notice {
    background: color-mix(in srgb, var(--green) 10%, var(--white));
    border: 1px solid var(--green-dark);
    border-radius: var(--radius);
    padding: 0.9rem 1rem;
    font-size: var(--step-small);
    color: var(--navy);
    max-width: 40rem;
    margin-bottom: 1rem;
  }
  .qf-notice code {
    font-size: 0.85em;
    background: color-mix(in srgb, var(--navy) 8%, transparent);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }
</style>

<script>
  // Turn each .quote-form into a 3-step wizard. If this script never runs,
  // every step stays visible and the form still submits as one page.
  document.querySelectorAll<HTMLFormElement>(".quote-form").forEach((form) => {
    const steps = Array.from(
      form.querySelectorAll<HTMLElement>(".qf-step")
    );
    if (steps.length < 2) return;
    const total = steps.length;
    const back = form.querySelector<HTMLButtonElement>(".qf-back")!;
    const next = form.querySelector<HTMLButtonElement>(".qf-next")!;
    const submit = form.querySelector<HTMLButtonElement>(".qf-submit")!;
    const num = form.querySelector<HTMLElement>(".qf-step-num")!;
    const barFill = form.querySelector<HTMLElement>(".qf-bar-fill")!;
    let current = 0;

    const render = () => {
      steps.forEach((s, i) => (s.hidden = i !== current));
      back.hidden = current === 0;
      next.hidden = current === total - 1;
      submit.hidden = current !== total - 1;
      num.textContent = `Step ${current + 1}`;
      barFill.style.width = `${((current + 1) / total) * 100}%`;
    };

    // Validate only the fields inside the current step.
    const stepValid = () => {
      const fields = steps[current].querySelectorAll<
        HTMLInputElement | HTMLTextAreaElement
      >("input, textarea, select");
      for (const f of fields) {
        if (!f.checkValidity()) {
          f.reportValidity();
          return false;
        }
      }
      return true;
    };

    next.addEventListener("click", () => {
      if (!stepValid()) return;
      current = Math.min(current + 1, total - 1);
      render();
      const legend = steps[current].querySelector("legend");
      (legend as HTMLElement | null)?.scrollIntoView({
        block: "nearest",
        behavior: "smooth",
      });
    });
    back.addEventListener("click", () => {
      current = Math.max(current - 1, 0);
      render();
    });

    render();
  });
</script>
