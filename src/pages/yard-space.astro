---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import Icon from "../components/Icon.astro";
import QuoteSection from "../components/QuoteSection.astro";
import { getCollection, getEntry } from "astro:content";
import { business, links } from "../data/business";

// Editable page text + photo (CMS: Page sections -> Yard space).
const page = (await getEntry("pages", "yard"))!.data;
const intro = page.intro!;

// Prices from the pricing collection so a CMS edit updates them everywhere.
const pricing = await getCollection("pricing");
const gatedP = pricing.find((e) => e.id === "yard")!;
const openP = pricing.find((e) => e.id === "open-storage")!;
const priceGated =
  gatedP.data.priceFrom != null
    ? `From £${gatedP.data.priceFrom}${gatedP.data.priceUnit}`
    : gatedP.data.priceNote;
const priceOpen =
  openP.data.priceFrom != null
    ? `From £${openP.data.priceFrom}${openP.data.priceUnit}`
    : openP.data.priceNote;

const title = "Yard Space & Open Storage Canterbury | Sturry Storage";
const description =
  "Gated storage yards and open storage space at Staines Hill, Sturry, Canterbury. Hardstanding for plant, trailers and vehicles. Call 07777 39 25 38.";
---

<Base title={title} description={description} path="/yard-space/">
  <section class="section container">
    <p class="crumb"><a href="/">Home</a> / Yard &amp; open storage</p>
    <h1>{intro.heading}</h1>
    <p class="section-lead">{intro.lead}</p>

    <!-- Gated storage yard: description + photo -->
    <div class="two-col">
      <div class="prose">
        <h2 class="unit-title">Gated storage yard</h2>
        <p>{intro.body![0]}</p>
        <p class="unit-price">{priceGated}</p>
      </div>
      <Photo
        src={intro.image!.src}
        alt={intro.image!.alt}
        objectPosition={intro.image!.objectPosition}
        ratio="4 / 3"
        widths={[480, 800, 1200]}
        sizes="(min-width: 800px) 44vw, 100vw"
        loading="eager"
        class="side-img"
      />
    </div>

    <hr class="unit-divider" />

    <!-- Open storage space: description + photo -->
    <div class="two-col reverse">
      <Photo
        src="/src/assets/yard-open.jpg"
        alt="Open gravel hardstanding with room for trailers and materials at Sturry Storage"
        objectPosition="50% 50%"
        ratio="4 / 3"
        widths={[480, 800, 1200]}
        sizes="(min-width: 800px) 44vw, 100vw"
        loading="lazy"
        class="side-img"
      />
      <div class="prose">
        <h2 class="unit-title">Open storage space</h2>
        <p>{intro.body![1]}</p>
        <p class="unit-price">{priceOpen}</p>
      </div>
    </div>

    <p class="terms-line">
      Paid weekly or monthly. Short or long term. No tie-ins or contracts.
    </p>

    <div class="cta-row">
      <a href={links.tel} class="btn btn-call">
        <Icon name="phone" size={19} />
        Call {business.phoneDisplay}
      </a>
      <a href={links.sms} class="btn btn-sms">
        <Icon name="message" size={19} />
        Text us
      </a>
      <a href={links.whatsapp} class="btn btn-whatsapp" target="_blank" rel="noopener">
        <Icon name="whatsapp" size={19} />
        WhatsApp us
      </a>
    </div>
  </section>

  <QuoteSection />
</Base>

<style>
  .crumb {
    font-size: var(--step-small);
    color: var(--steel);
    margin-bottom: 0.5rem;
  }
  .crumb a {
    color: var(--green-dark);
  }
  .section-lead {
    margin-top: 0.5rem;
    color: var(--steel);
    font-size: var(--step-body-lg);
    max-width: var(--measure);
  }
  .two-col {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    margin-top: 1.75rem;
    align-items: start;
  }
  .prose {
    display: grid;
    gap: 1rem;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.75rem;
  }
  .unit-title {
    font-size: var(--step-h3);
    color: var(--navy);
    margin: 0;
  }
  /* Bold, green price line at the foot of each unit's description. */
  .unit-price {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--step-body-lg);
    color: var(--green-dark);
    margin: 0.15rem 0 0;
  }
  /* Thin hairline between the gated-yard block and the open-storage block. */
  .unit-divider {
    border: 0;
    border-top: 1px solid var(--hairline);
    margin: 2.5rem 0;
  }
  .terms-line {
    margin-top: 1rem;
    font-weight: 500;
    color: var(--navy);
  }
  .two-col :global(picture) {
    display: block;
  }
  .side-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    display: block;
  }
  @media (min-width: 800px) {
    .two-col {
      grid-template-columns: 1.2fr 1fr;
      gap: 3rem;
    }
    /* Open-storage block: photo on the left, text on the right. */
    .two-col.reverse {
      grid-template-columns: 1fr 1.2fr;
    }
  }
</style>
