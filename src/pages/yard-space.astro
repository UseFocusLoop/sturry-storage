---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import Icon from "../components/Icon.astro";
import { getEntry } from "astro:content";
import { business, links } from "../data/business";

// Editable page text + photos (CMS: Page sections -> Yard space).
const page = (await getEntry("pages", "yard"))!.data;
const intro = page.intro!;
const second = page.second!;

const title = "Open Yard & Outdoor Storage in Sturry, Canterbury | Sturry Storage";
const description =
  "Open yard storage space at Staines Hill, Sturry, Canterbury. Hardstanding for plant, trailers and vehicles. Priced on requirement. Call 07777 39 25 38.";
---

<Base title={title} description={description} path="/yard-space/">
  <section class="section container">
    <p class="crumb"><a href="/">Home</a> / Yard space</p>
    <h1>{intro.heading}</h1>
    <p class="section-lead">{intro.lead}</p>

    <div class="two-col">
      <div class="prose">
        {intro.body!.map((para) => <p>{para}</p>)}
        <div class="cta-row">
          <a href={links.tel} class="btn btn-primary">
            <Icon name="phone" size={19} />
            Call {business.phoneDisplay}
          </a>
          <a href={links.whatsapp} class="btn btn-wa" target="_blank" rel="noopener">
            <Icon name="whatsapp" size={19} />
            WhatsApp us
          </a>
        </div>
      </div>
      <Photo
        src={intro.image!.src}
        alt={intro.image!.alt}
        objectPosition={intro.image!.objectPosition}
        ratio="4 / 3"
        widths={[480, 800, 1200]}
        sizes="(min-width: 800px) 44vw, 100vw"
        loading="eager"
        class="side-img"
      />
    </div>
  </section>

  <section class="section container">
    <h2>{second.heading}</h2>
    <div class="two-col reverse">
      <Photo
        src={second.image!.src}
        alt={second.image!.alt}
        objectPosition={second.image!.objectPosition}
        ratio="4 / 3"
        widths={[480, 800, 1200]}
        sizes="(min-width: 800px) 44vw, 100vw"
        loading="lazy"
        class="side-img"
      />
      <div class="prose">
        <p>{second.body1}</p>
        <p>
          {
            business.hgvParking === true
              ? "HGV and larger vehicle parking is available — call to check we can fit yours."
              : business.hgvParking === false
                ? "For larger commercial vehicles, call first so we can check the fit."
                : "Larger vehicles and HGVs — call first so we can check the fit." /* [CONFIRM] HGV/vehicle parking */
          }
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .crumb {
    font-size: var(--step-small);
    color: var(--steel);
    margin-bottom: 0.5rem;
  }
  .crumb a {
    color: var(--green-dark);
  }
  .section-lead {
    margin-top: 0.5rem;
    color: var(--steel);
    font-size: var(--step-body-lg);
    max-width: var(--measure);
  }
  .two-col {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    margin-top: 1.75rem;
    align-items: start;
  }
  .prose {
    display: grid;
    gap: 1rem;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .two-col :global(picture) {
    display: block;
  }
  .side-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    display: block;
  }
  @media (min-width: 800px) {
    .two-col {
      grid-template-columns: 1.2fr 1fr;
      gap: 3rem;
    }
    .two-col.reverse {
      grid-template-columns: 1fr 1.2fr;
    }
  }
</style>
