---
import Base from "../layouts/Base.astro";
import { business, links } from "../data/business";

const title = "Page not found | Sturry Storage";
const description = "Sorry, we couldn't find that page.";
---

<Base title={title} description={description} path="/404/" noindex={true}>
  <section class="section container not-found">
    <p class="nf-code">404</p>
    <h1>Sorry, we can't find that page</h1>
    <p class="section-lead">
      The link may be old or mistyped. Try one of these instead, or give us a
      ring and we'll help you find the right storage.
    </p>
    <ul class="nf-links">
      <li><a href="/">Home</a></li>
      <li><a href="/container-storage/">Container storage</a></li>
      <li><a href="/yard-space/">Yard &amp; open storage</a></li>
      <li><a href="/#quote">Get a quote</a></li>
    </ul>
    <div class="actions">
      <a href={links.tel} class="btn btn-primary">Call {business.phoneDisplay}</a>
      <a href="/" class="btn btn-ghost">Back to home</a>
    </div>
  </section>
</Base>

<style>
  .not-found {
    min-height: 40vh;
  }
  .nf-code {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--step-small);
    letter-spacing: 0.08em;
    color: var(--green-dark);
    margin: 0 0 0.5rem;
  }
  .section-lead {
    margin-top: 0.75rem;
    color: var(--steel);
    font-size: var(--step-body-lg);
    max-width: var(--measure);
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    font-weight: 500;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.75rem;
  }
</style>
