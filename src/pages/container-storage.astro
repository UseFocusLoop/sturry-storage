---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import Icon from "../components/Icon.astro";
import QuoteSection from "../components/QuoteSection.astro";
import { getCollection, getEntry } from "astro:content";
import { business, links } from "../data/business";

// Editable page text + side photo (CMS: Page sections -> Container storage).
const page = (await getEntry("pages", "container"))!.data;
const intro = page.intro!;

// Prices come from the pricing collection so a CMS edit updates them everywhere.
const pricing = await getCollection("pricing");
const twenty = pricing.find((e) => e.id === "container-20")!;
const forty = pricing.find((e) => e.id === "container-40")!;
const heroPrice = `£${twenty.data.priceFrom ?? 35}`;
const price20 = `Priced from £${twenty.data.priceFrom}${twenty.data.priceUnit}`;
const price40 = `Priced from £${forty.data.priceFrom}${forty.data.priceUnit}`;
const title = "20ft & 40ft Container Storage Canterbury | Sturry Storage";
const description =
  "Secure 20ft & 40ft container storage at Staines Hill, Sturry, Canterbury. Drive-up access, 24hr CCTV, weekly terms from £35. Call 07777 39 25 38 or WhatsApp.";
---

<Base title={title} description={description} path="/container-storage/">
  <section class="section container">
    <p class="crumb"><a href="/">Home</a> / Container storage</p>
    <h1>{intro.heading}</h1>
    <p class="section-lead">
      {intro.leadBefore}<span class="tnum">{heroPrice}</span>{intro.leadAfter}
    </p>

    <!-- 20ft container: description + photo -->
    <div class="two-col">
      <div class="prose">
        <h2 class="unit-title">20ft container</h2>
        <p>{intro.body![0]}</p>
        <p class="unit-price">{price20}</p>
      </div>
      <Photo
        src={intro.image!.src}
        alt={intro.image!.alt}
        objectPosition={intro.image!.objectPosition}
        ratio="4 / 3"
        widths={[480, 800, 1200]}
        sizes="(min-width: 800px) 40vw, 100vw"
        loading="lazy"
        class="side-img"
      />
    </div>

    <hr class="unit-divider" />

    <!-- 40ft container: description + photo -->
    <div class="two-col reverse">
      <Photo
        src="/src/assets/container-interior.jpg"
        alt="Inside a clean, dry storage container at Sturry Storage"
        objectPosition="50% 50%"
        ratio="4 / 3"
        widths={[480, 800, 1200]}
        sizes="(min-width: 800px) 40vw, 100vw"
        loading="lazy"
        class="side-img"
      />
      <div class="prose">
        <h2 class="unit-title">40ft container</h2>
        <p>{intro.body![1]}</p>
        <p class="unit-price">{price40}</p>
      </div>
    </div>

    <p class="terms-line">
      Paid weekly or monthly. Short or long term. No tie-ins or contracts.
    </p>

    <div class="cta-row">
      <a href={links.tel} class="btn btn-call">
        <Icon name="phone" size={19} />
        Call {business.phoneDisplay}
      </a>
      <a href={links.sms} class="btn btn-sms">
        <Icon name="message" size={19} />
        Text us
      </a>
      <a href={links.whatsapp} class="btn btn-whatsapp" target="_blank" rel="noopener">
        <Icon name="whatsapp" size={19} />
        WhatsApp us
      </a>
    </div>
  </section>

  <QuoteSection />
</Base>

<style>
  .crumb {
    font-size: var(--step-small);
    color: var(--steel);
    margin-bottom: 0.5rem;
  }
  .crumb a {
    color: var(--green-dark);
  }
  .section-lead {
    margin-top: 0.5rem;
    color: var(--steel);
    font-size: var(--step-body-lg);
    max-width: var(--measure);
  }
  .two-col {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    margin-top: 1.75rem;
    align-items: start;
  }
  .prose {
    display: grid;
    gap: 1rem;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.75rem;
  }
  .unit-title {
    font-size: var(--step-h3);
    color: var(--navy);
    margin: 0;
  }
  /* Bold, green price line at the foot of each unit's description. */
  .unit-price {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--step-body-lg);
    color: var(--green-dark);
    margin: 0.15rem 0 0;
  }
  /* Thin hairline between the 20ft block and the 40ft block. */
  .unit-divider {
    border: 0;
    border-top: 1px solid var(--hairline);
    margin: 2.5rem 0;
  }
  .two-col :global(picture) {
    display: block;
  }
  .side-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    display: block;
  }
  .terms-line {
    margin-top: 1rem;
    font-weight: 500;
  }
  @media (min-width: 800px) {
    .two-col {
      grid-template-columns: 1.2fr 1fr;
      gap: 3rem;
    }
    /* 40ft block: photo on the left, text on the right, for visual rhythm. */
    .two-col.reverse {
      grid-template-columns: 1fr 1.2fr;
    }
  }
</style>
