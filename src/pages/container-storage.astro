---
import Base from "../layouts/Base.astro";
import PricingTable from "../components/PricingTable.astro";
import Photo from "../components/Photo.astro";
import Icon from "../components/Icon.astro";
import QuoteSection from "../components/QuoteSection.astro";
import { getCollection, getEntry } from "astro:content";
import { business, links } from "../data/business";

// Editable page text + side photo (CMS: Page sections -> Container storage).
const page = (await getEntry("pages", "container"))!.data;
const intro = page.intro!;
const pricingSection = page.pricing!;

const twenty = (await getCollection("pricing")).find((e) => e.id === "container-20");
const heroPrice = `£${twenty?.data.priceFrom ?? 35}`;
const title = "20ft Container Storage in Sturry, Canterbury | Sturry Storage";
const description =
  "Secure 20ft container storage at Staines Hill, Sturry, Canterbury. Drive-up access, 24hr CCTV, weekly terms from £35. Call 07777 39 25 38 or WhatsApp.";
---

<Base title={title} description={description} path="/container-storage/">
  <section class="section container">
    <p class="crumb"><a href="/">Home</a> / Container storage</p>
    <h1>{intro.heading}</h1>
    <p class="section-lead">
      {intro.leadBefore}<span class="tnum">{heroPrice}</span>{intro.leadAfter}
    </p>

    <div class="two-col">
      <div class="prose">
        {intro.body!.map((para) => <p>{para}</p>)}
        <div class="cta-row">
          <a href={links.tel} class="btn btn-primary">
            <Icon name="phone" size={19} />
            Call {business.phoneDisplay}
          </a>
          <a href={links.sms} class="btn btn-ghost">
            <Icon name="message" size={19} />
            Text us
          </a>
          <a href={links.whatsapp} class="btn btn-wa" target="_blank" rel="noopener">
            <Icon name="whatsapp" size={19} />
            WhatsApp us
          </a>
        </div>
      </div>
      <Photo
        src={intro.image!.src}
        alt={intro.image!.alt}
        objectPosition={intro.image!.objectPosition}
        ratio="3 / 2"
        widths={[480, 800, 1200]}
        sizes="(min-width: 800px) 40vw, 100vw"
        loading="lazy"
        class="side-img"
      />
    </div>
  </section>

  <section class="section container">
    <h2>{pricingSection.heading}</h2>
    <PricingTable category="container" />
    <p class="terms-line">
      Paid weekly or monthly. Short or long term. No tie-ins or contracts.
    </p>
  </section>

  <QuoteSection />
</Base>

<style>
  .crumb {
    font-size: var(--step-small);
    color: var(--steel);
    margin-bottom: 0.5rem;
  }
  .crumb a {
    color: var(--green-dark);
  }
  .section-lead {
    margin-top: 0.5rem;
    color: var(--steel);
    font-size: var(--step-body-lg);
    max-width: var(--measure);
  }
  .two-col {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    margin-top: 1.75rem;
    align-items: start;
  }
  .prose {
    display: grid;
    gap: 1rem;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .two-col :global(picture) {
    display: block;
  }
  .side-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    display: block;
  }
  .terms-line {
    margin-top: 1rem;
    font-weight: 500;
  }
  @media (min-width: 800px) {
    .two-col {
      grid-template-columns: 1.2fr 1fr;
      gap: 3rem;
    }
  }
</style>
