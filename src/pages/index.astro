---
import Base from "../layouts/Base.astro";
import { Picture } from "astro:assets";
import Photo from "../components/Photo.astro";
import QuoteSection from "../components/QuoteSection.astro";
import Icon from "../components/Icon.astro";
import { getCollection, getEntry } from "astro:content";
import { business, links, addressOneLine } from "../data/business";
import { resolveImage } from "../lib/resolveImage";

// Editable page text + hero photo (CMS: Page sections -> Home).
const home = (await getEntry("pages", "home"))!.data;
const hero = home.hero!;
const pricingSection = home.pricing!;
const security = home.security!;
const finding = home.finding!;

// Map pin. The postcode geocodes to the wrong spot, so we pin exact
// coordinates: down Staines Hill, between the Redcot Lane junction and
// Jennywood nature reserve. Same point powers the map and the address link.
const mapPin = "51.3086,1.1392";
const mapEmbed = `https://www.google.com/maps?q=${mapPin}&z=16&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${mapPin}`;
const mapDirections = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
  addressOneLine
)}`;
const heroAddress = `${business.address.line1}, ${business.address.town}, ${business.address.city}, ${business.address.postcode}`;

// Hero photo, swapped from the CMS and optimised at build time.
const heroImg = resolveImage(hero.image.src);
const heroPos = hero.image.objectPosition;

// Icons for the first three security cards, in order. The fourth ("Easy
// access") stays in code because its text follows the access-hours setting.
const factIcons = ["shield", "lock", "truck"] as const;

// Pricing rows power the hero price line and the three summary cards below.
const pricingRows = await getCollection("pricing");
const priceOf = (id: string) => pricingRows.find((e) => e.id === id)!.data;
const heroPrice = `£${priceOf("container-20").priceFrom ?? 35}`;

const cardPrice = (
  d: { priceFrom?: number | null; priceUnit: string; priceNote: string },
  prefix: string
) => (d.priceFrom != null ? `${prefix} £${d.priceFrom}${d.priceUnit}` : d.priceNote);

const cards = [
  {
    title: "20ft container",
    fits: priceOf("container-20").whatFits,
    price: cardPrice(priceOf("container-20"), "Priced from"),
    img: "/src/assets/container-20.jpg",
    alt: "Inside a brand-new 20ft steel container at Sturry Storage",
    pos: "50% 50%",
    href: "/container-storage/",
  },
  {
    title: "40ft container",
    fits: priceOf("container-40").whatFits,
    price: cardPrice(priceOf("container-40"), "Priced from"),
    img: "/src/assets/container-40.jpg",
    alt: "Inside a brand-new 40ft steel container at Sturry Storage",
    pos: "50% 50%",
    href: "/container-storage/",
  },
  {
    title: "Yard & open storage",
    fits: priceOf("yard").whatFits,
    price: cardPrice(priceOf("yard"), "From"),
    img: "/src/assets/gated-yard.jpg",
    alt: "Open green gates to a gated hardstanding storage yard at Sturry, Canterbury",
    pos: "50% 50%",
    href: "/yard-space/",
  },
];
const title = "Self Storage Canterbury & Sturry | Sturry Storage";
const description =
  "Secure 20ft & 40ft container storage and gated/open yard space at Staines Hill, Sturry, Canterbury. Drive-up access, 24hr CCTV, flexible weekly terms. Call 07777 39 25 38.";
---

<Base title={title} description={description} path="/">
  <!-- ============================ HERO ============================ -->
  <section class="hero">
    <div class="hero-photo" aria-hidden="true">
      <Picture
        src={heroImg}
        formats={["avif", "webp"]}
        alt=""
        widths={[768, 1100, 1280]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="hero-img"
        style={heroPos !== "50% 50%" ? `object-position:${heroPos}` : undefined}
      />
    </div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="container hero-content">
      <a
        class="hero-eyebrow"
        href={mapLink}
        target="_blank"
        rel="noopener"
        aria-label={`Open ${heroAddress} in Google Maps`}
      >
        <Icon name="pin" size={16} />
        {heroAddress}
      </a>
      <h1>{hero.heading}</h1>
      <p class="hero-lead">
        {hero.leadBefore}<span class="tnum">{heroPrice}</span>{hero.leadAfter}
      </p>
      <div class="hero-actions">
        <a href={links.tel} class="btn btn-glass btn-lg">
          <Icon name="phone" size={20} />
          Call {business.phoneDisplay}
        </a>
        <a
          href={links.whatsapp}
          class="btn btn-whatsapp btn-lg"
          target="_blank"
          rel="noopener"
        >
          <Icon name="whatsapp" size={20} />
          WhatsApp us
        </a>
      </div>
      <ul class="hero-trust">
        <li><Icon name="check" size={18} /> 24hr CCTV</li>
        <li><Icon name="check" size={18} /> Gated site</li>
        <li><Icon name="check" size={18} /> Drive-up access</li>
        <li><Icon name="check" size={18} /> Short or long term</li>
      </ul>
    </div>
    <div class="corrugation-rib" aria-hidden="true"></div>
  </section>

  <!-- ===================== SIZES AND PRICING ===================== -->
  <section class="section container">
    <div class="section-head">
      <h2>{pricingSection.heading}</h2>
      <p class="lead">{pricingSection.lead}</p>
    </div>
    <ul class="cards" role="list">
      {
        cards.map((c) => (
          <li class="card">
            <a class="card-media" href={c.href} aria-label={c.title}>
              <Photo
                src={c.img}
                alt={c.alt}
                objectPosition={c.pos}
                ratio="3 / 4"
                widths={[400, 600, 800]}
                sizes="(min-width: 720px) 30vw, 100vw"
                loading="lazy"
                class="card-img"
              />
            </a>
            <div class="card-body">
              <h3 class="card-title">{c.title}</h3>
              <p class="card-fits">{c.fits}</p>
              <p class="card-price">{c.price}</p>
              <a href={c.href} class="btn btn-primary card-btn">
                See details
              </a>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="terms-line">
      Paid weekly or monthly. Short or long term. No tie-ins or contracts.
    </p>
  </section>

  <!-- ===================== SECURITY & ACCESS ===================== -->
  <!-- The one full-bleed dark section on the page. -->
  <section class="security">
    <div class="container">
      <div class="section-head">
        <h2>{security.heading}</h2>
        {security.lead && <p class="lead security-lead">{security.lead}</p>}
      </div>
      <ul class="facts">
        {
          security.facts.map((f, i) => (
            <li>
              <span class="fact-ic"><Icon name={factIcons[i] ?? "check"} size={24} /></span>
              <strong>{f.title}</strong>
              <span class="fact-text">{f.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ========================= FINDING US ========================= -->
  <section class="section container finding" id="finding-us">
    <div class="corrugation-texture" aria-hidden="true"></div>
    <div class="finding-inner">
      <div class="finding-copy">
        <h2>{finding.heading}</h2>
        <address class="address">
          {business.legalName}<br />
          {business.address.line1}<br />
          {business.address.town}, {business.address.city}<br />
          {business.address.county} {business.address.postcode}
        </address>
        <p class="addr-directions">
          <a href={mapDirections} target="_blank" rel="noopener">
            <Icon name="pin" size={16} /> Get directions
          </a>
        </p>

        {
          finding.directions.map((d) => (
            <Fragment>
              <h3>{d.heading}</h3>
              <p>{d.body}</p>
            </Fragment>
          ))
        }

        <p class="areas">{finding.areas}</p>
      </div>

      <div class="finding-map">
        <iframe
          title={`Map showing ${business.legalName} at ${addressOneLine}`}
          src={mapEmbed}
          width="600"
          height="450"
          style="border:0; width:100%; height:100%;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>

  <!-- ========================== ENQUIRY ========================== -->
  <QuoteSection />
</Base>

<style>
  /* ---- Hero (photographic) ---- */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(30rem, 62vh, 44rem);
    overflow: hidden;
    isolation: isolate;
  }
  /* ---- Hero photo (single static image) ---- */
  .hero-photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    background: var(--navy-deep);
  }
  .hero-photo :global(picture) {
    display: contents;
  }
  .hero-photo :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--hero-scrim);
  }
  .hero-content {
    padding-block: clamp(3rem, 2rem + 6vw, 6rem);
    color: var(--white);
    max-width: 62rem;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 1.1rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease;
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }
  a.hero-eyebrow:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.45);
  }
  .hero-eyebrow .icon {
    color: var(--green-bright);
  }
  .hero-content h1 {
    color: var(--white);
    max-width: 20ch;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25);
  }
  .hero-lead {
    font-size: var(--step-body-lg);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 1.25rem;
    max-width: 46ch;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }
  .hero-trust {
    list-style: none;
    padding: 1.6rem 0 0;
    margin: 1.75rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.6rem;
  }
  .hero-trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: var(--step-small);
    color: #fff;
  }
  .hero-trust .icon {
    color: var(--green-bright);
  }
  /* Container-rib accent along the bottom edge of the hero. */
  .corrugation-rib {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 8px;
    background-image: repeating-linear-gradient(
      90deg,
      var(--green) 0,
      var(--green) 3px,
      var(--navy-deep) 3px,
      var(--navy-deep) 9px
    );
  }
  @media (max-width: 767px) {
    .hero {
      min-height: 0;
    }
    .hero-content {
      padding-top: 2.5rem;
      padding-bottom: 3.5rem;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn {
      width: 100%;
    }
  }

  .terms-line {
    margin-top: 1.25rem;
    font-weight: 500;
    color: var(--navy);
  }

  /* ---- Three summary cards (sizes + pricing) ---- */
  .cards {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  .card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .card-media {
    display: block;
    line-height: 0;
  }
  .card :global(.card-img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    flex: 1;
  }
  .card-title {
    font-size: var(--step-h3);
    color: var(--navy);
    margin: 0;
  }
  /* flex:1 pushes price + button to a common baseline across all three cards */
  .card-fits {
    color: var(--steel);
    line-height: 1.5;
    margin: 0;
    flex: 1;
  }
  .card-price {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--step-body-lg);
    color: var(--green-dark);
    margin: 0.35rem 0 0;
  }
  .card-btn {
    align-self: start;
    margin-top: 0.85rem;
  }
  @media (min-width: 720px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ---- Security (inverted) ---- */
  .security {
    background: var(--navy-deep);
    color: color-mix(in srgb, var(--white) 82%, var(--navy-deep));
    padding-block: var(--section-y);
  }
  .security :global(h2) {
    color: var(--white);
  }
  .security-lead {
    color: color-mix(in srgb, var(--white) 68%, var(--navy-deep)) !important;
  }
  .facts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  .facts li {
    line-height: 1.5;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .fact-ic {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    background: color-mix(in srgb, var(--green) 22%, transparent);
    color: var(--green-bright);
    margin-bottom: 0.9rem;
  }
  .facts strong {
    display: block;
    color: var(--white);
    font-family: var(--font-head);
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 0.3rem;
  }
  .facts .fact-text {
    color: color-mix(in srgb, var(--white) 68%, var(--navy-deep));
    display: block;
  }
  @media (min-width: 560px) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 940px) {
    .facts {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ---- Finding us ---- */
  .finding {
    position: relative;
  }
  .finding .corrugation-texture {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .finding-inner {
    position: relative;
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    align-items: start;
  }
  .address {
    font-style: normal;
    font-size: var(--step-body-lg);
    line-height: 1.5;
    margin: 1rem 0 0.75rem;
  }
  .addr-directions {
    margin: 0 0 1.5rem;
  }
  .addr-directions a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--green-dark);
    font-weight: 500;
    text-decoration: none;
  }
  .addr-directions a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .finding h3 {
    margin: 1.25rem 0 0.35rem;
  }
  .areas {
    margin-top: 1.25rem;
    color: var(--navy);
  }
  .finding-map {
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    min-height: 320px;
  }
  @media (min-width: 900px) {
    .finding-inner {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
</style>
