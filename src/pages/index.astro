---
import Base from "../layouts/Base.astro";
import { Picture } from "astro:assets";
import PricingTable from "../components/PricingTable.astro";
import QuoteSection from "../components/QuoteSection.astro";
import Icon from "../components/Icon.astro";
import { getCollection, getEntry } from "astro:content";
import { business, links, addressOneLine } from "../data/business";
import { resolveImage } from "../lib/resolveImage";
// Extra hero slides for the auto-fading slideshow (first slide is the CMS one).
import slideGate from "../assets/yard-gate.jpg";
import slideOpen from "../assets/yard-open.jpg";

// Editable page text + hero photo (CMS: Page sections -> Home).
const home = (await getEntry("pages", "home"))!.data;
const hero = home.hero!;
const pricingSection = home.pricing!;
const security = home.security!;
const finding = home.finding!;

// Hero photo, swapped from the CMS and optimised at build time.
const heroImg = resolveImage(hero.image.src);
const heroPos = hero.image.objectPosition;

// Icons for the first three security cards, in order. The fourth ("Easy
// access") stays in code because its text follows the access-hours setting.
const factIcons = ["shield", "lock", "truck"] as const;

// 20ft "from" price for the hero line, read from the pricing collection.
const twenty = (await getCollection("pricing")).find((e) => e.id === "container-20");
const heroPrice = `£${twenty?.data.priceFrom ?? 35}`;
const title =
  "Container & Yard Storage in Sturry, Canterbury | Sturry Storage Solutions";
const description =
  "Secure 20ft container storage and open yard space at Staines Hill, Sturry, Canterbury. Drive-up access, 24hr CCTV, flexible weekly terms. Call 07777 39 25 38.";
---

<Base title={title} description={description} path="/">
  <!-- ============================ HERO ============================ -->
  <section class="hero">
    <div class="hero-slideshow" aria-hidden="true">
      <Picture
        src={heroImg}
        formats={["avif", "webp"]}
        alt=""
        widths={[768, 1100, 1280]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="hero-slide"
        style={heroPos !== "50% 50%" ? `object-position:${heroPos}` : undefined}
      />
      <Picture
        src={slideGate}
        formats={["avif", "webp"]}
        alt=""
        widths={[768, 1100, 1280]}
        sizes="100vw"
        loading="lazy"
        class="hero-slide"
      />
      <Picture
        src={slideOpen}
        formats={["avif", "webp"]}
        alt=""
        widths={[768, 1100, 1280]}
        sizes="100vw"
        loading="lazy"
        class="hero-slide"
      />
    </div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="container hero-content">
      <p class="hero-eyebrow">
        <Icon name="pin" size={16} />
        {business.address.town}, {business.address.city} &middot; {business.address.postcode}
      </p>
      <h1>{hero.heading}</h1>
      <p class="hero-lead">
        {hero.leadBefore}<span class="tnum">{heroPrice}</span>{hero.leadAfter}
      </p>
      <div class="hero-actions">
        <a href={links.tel} class="btn btn-primary btn-lg">
          <Icon name="phone" size={20} />
          Call {business.phoneDisplay}
        </a>
        <a
          href={links.whatsapp}
          class="btn btn-glass btn-lg"
          target="_blank"
          rel="noopener"
        >
          <Icon name="whatsapp" size={20} />
          WhatsApp us
        </a>
      </div>
      <ul class="hero-trust">
        <li><Icon name="check" size={18} /> 24hr CCTV</li>
        <li><Icon name="check" size={18} /> Gated site</li>
        <li><Icon name="check" size={18} /> Drive-up access</li>
        <li><Icon name="check" size={18} /> Short or long term</li>
      </ul>
    </div>
    <div class="corrugation-rib" aria-hidden="true"></div>
  </section>

  <!-- ===================== SIZES AND PRICING ===================== -->
  <section class="section container">
    <div class="section-head">
      <h2>{pricingSection.heading}</h2>
      <p class="lead">{pricingSection.lead}</p>
    </div>
    <PricingTable />
    <p class="terms-line">
      Paid weekly. Short or long term. {
        business.minimumTerm
          ? business.minimumTerm
          : "No long tie-in" /* [CONFIRM] minimum term */
      }.
    </p>
  </section>

  <!-- ===================== SECURITY & ACCESS ===================== -->
  <!-- The one full-bleed dark section on the page. -->
  <section class="security">
    <div class="container">
      <div class="section-head">
        <h2>{security.heading}</h2>
        <p class="lead security-lead">
          {security.lead}
        </p>
      </div>
      <ul class="facts">
        {
          security.facts.map((f, i) => (
            <li>
              <span class="fact-ic"><Icon name={factIcons[i] ?? "check"} size={24} /></span>
              <strong>{f.title}</strong>
              <span class="fact-text">{f.text}</span>
            </li>
          ))
        }
        <li>
          <span class="fact-ic"><Icon name="clock" size={24} /></span>
          <strong>Easy access</strong>
          <span class="fact-text">
            {
              business.accessHoursConfirmed
                ? business.accessHours
                : "Access arranged to suit you — ask when you call." /* [CONFIRM] access hours. NOT 24/7. */
            }
          </span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ========================= FINDING US ========================= -->
  <section class="section container finding" id="finding-us">
    <div class="corrugation-texture" aria-hidden="true"></div>
    <div class="finding-inner">
      <div class="finding-copy">
        <h2>{finding.heading}</h2>
        <address class="address">
          {business.legalName}<br />
          {business.address.line1}<br />
          {business.address.town}, {business.address.city}<br />
          {business.address.county} {business.address.postcode}
        </address>

        {
          finding.directions.map((d) => (
            <Fragment>
              <h3>{d.heading}</h3>
              <p>{d.body}</p>
            </Fragment>
          ))
        }

        <p class="areas">{finding.areas}</p>
      </div>

      <div class="finding-map">
        <iframe
          title={`Map showing ${business.legalName} at ${addressOneLine}`}
          src={`https://www.google.com/maps?q=${encodeURIComponent(
            addressOneLine
          )}&output=embed`}
          width="600"
          height="450"
          style="border:0; width:100%; height:100%;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>

  <!-- ========================== ENQUIRY ========================== -->
  <QuoteSection />
</Base>

<style>
  /* ---- Hero (photographic) ---- */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(30rem, 62vh, 44rem);
    overflow: hidden;
    isolation: isolate;
  }
  /* ---- Hero slideshow (auto-fading, no JS) ---- */
  .hero-slideshow {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    background: var(--navy-deep);
  }
  .hero-slideshow :global(picture) {
    display: contents;
  }
  .hero-slideshow :global(.hero-slide) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    animation: heroFade 18s ease-in-out infinite;
  }
  .hero-slideshow :global(picture:nth-of-type(1) .hero-slide) {
    animation-delay: 0s;
  }
  .hero-slideshow :global(picture:nth-of-type(2) .hero-slide) {
    animation-delay: 6s;
  }
  .hero-slideshow :global(picture:nth-of-type(3) .hero-slide) {
    animation-delay: 12s;
  }
  @keyframes heroFade {
    0% {
      opacity: 0;
    }
    3% {
      opacity: 1;
    }
    30% {
      opacity: 1;
    }
    36% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }
  /* Reduced motion: no crossfade, just show the first photo. */
  @media (prefers-reduced-motion: reduce) {
    .hero-slideshow :global(.hero-slide) {
      animation: none !important;
      opacity: 0;
    }
    .hero-slideshow :global(picture:nth-of-type(1) .hero-slide) {
      opacity: 1;
    }
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--hero-scrim);
  }
  .hero-content {
    padding-block: clamp(3rem, 2rem + 6vw, 6rem);
    color: var(--white);
    max-width: 62rem;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 1.1rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }
  .hero-eyebrow .icon {
    color: var(--green-bright);
  }
  .hero-content h1 {
    color: var(--white);
    max-width: 20ch;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25);
  }
  .hero-lead {
    font-size: var(--step-body-lg);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 1.25rem;
    max-width: 46ch;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }
  .hero-trust {
    list-style: none;
    padding: 1.6rem 0 0;
    margin: 1.75rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.6rem;
  }
  .hero-trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: var(--step-small);
    color: #fff;
  }
  .hero-trust .icon {
    color: var(--green-bright);
  }
  /* Container-rib accent along the bottom edge of the hero. */
  .corrugation-rib {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 8px;
    background-image: repeating-linear-gradient(
      90deg,
      var(--green) 0,
      var(--green) 3px,
      var(--navy-deep) 3px,
      var(--navy-deep) 9px
    );
  }
  @media (max-width: 767px) {
    .hero {
      min-height: 0;
    }
    .hero-content {
      padding-top: 2.5rem;
      padding-bottom: 3.5rem;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn {
      width: 100%;
    }
  }

  .terms-line {
    margin-top: 1.25rem;
    font-weight: 500;
    color: var(--navy);
  }

  /* ---- Security (inverted) ---- */
  .security {
    background: var(--navy-deep);
    color: color-mix(in srgb, var(--white) 82%, var(--navy-deep));
    padding-block: var(--section-y);
  }
  .security :global(h2) {
    color: var(--white);
  }
  .security-lead {
    color: color-mix(in srgb, var(--white) 68%, var(--navy-deep)) !important;
  }
  .facts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  .facts li {
    line-height: 1.5;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .fact-ic {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    background: color-mix(in srgb, var(--green) 22%, transparent);
    color: var(--green-bright);
    margin-bottom: 0.9rem;
  }
  .facts strong {
    display: block;
    color: var(--white);
    font-family: var(--font-head);
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 0.3rem;
  }
  .facts .fact-text {
    color: color-mix(in srgb, var(--white) 68%, var(--navy-deep));
    display: block;
  }
  @media (min-width: 560px) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 940px) {
    .facts {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ---- Finding us ---- */
  .finding {
    position: relative;
  }
  .finding .corrugation-texture {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .finding-inner {
    position: relative;
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    align-items: start;
  }
  .address {
    font-style: normal;
    font-size: var(--step-body-lg);
    line-height: 1.5;
    margin: 1rem 0 1.5rem;
  }
  .finding h3 {
    margin: 1.25rem 0 0.35rem;
  }
  .areas {
    margin-top: 1.25rem;
    color: var(--navy);
  }
  .finding-map {
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    min-height: 320px;
  }
  @media (min-width: 900px) {
    .finding-inner {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
</style>
